<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.OpenTV" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/bg</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
        <item name="android:textColorHint">@color/text_faint</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="Theme.OpenTV.Player" parent="Theme.OpenTV">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <!-- 对话框主题：深色面板 -->
    <style name="Theme.OpenTV.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_panel</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:backgroundDimAmount">0.72</item>
        <item name="android:windowMinWidthMajor">46%</item>
        <item name="android:windowMinWidthMinor">82%</item>
    </style>
</resources>
