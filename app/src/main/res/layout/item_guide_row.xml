<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="62dp"
    android:orientation="horizontal">

    <!-- 左侧固定频道列 -->
    <LinearLayout
        android:id="@+id/channelCell"
        android:layout_width="@dimen/guide_left_width"
        android:layout_height="match_parent"
        android:background="@color/panel"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/number"
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/text_faint"
            android:textSize="11sp" />

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_logo">

            <ImageView
                android:id="@+id/logo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:padding="3dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_tv_dim" />
        </FrameLayout>

        <TextView
            android:id="@+id/name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 右侧节目时间轴 -->
    <com.opentv.player.ui.SyncScrollView
        android:id="@+id/programScroll"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/programRow"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </com.opentv.player.ui.SyncScrollView>
</LinearLayout>
