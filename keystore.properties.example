# 复制本文件为 keystore.properties 并填入你自己的签名信息
# （keystore.properties 已被 .gitignore 排除，不会提交到仓库）
#
# 生成签名密钥（JDK 自带 keytool）：
#   keytool -genkeypair -v -keystore my-release.jks -alias opentv \
#     -keyalg RSA -keysize 2048 -validity 10950
#
# 提示：正式分发的版本请务必备份这个 .jks 文件；
#      后续升级必须使用同一个密钥签名，否则无法覆盖安装。

storeFile=my-release.jks
storePassword=你的密钥库密码
keyAlias=opentv
keyPassword=你的密钥密码
